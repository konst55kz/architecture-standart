@startuml c4_context
!include <C4/C4_Context>
LAYOUT_TOP_DOWN()
skinparam defaultFontName "DejaVu Sans"
skinparam wrapWidth 260
AddElementTag("new", $bgColor="#2E7D32", $borderColor="#1B5E20", $legendText="новая система")

title Контекстная диаграмма (C4 Level 1): онлайн-открытие депозитов, MVP

Person(newClient, "Новый клиент", "Ещё не клиент банка. Узнаёт ставки и оставляет заявку на сайте")
Person(client, "Клиент интернет-банка", "Действующий клиент. Подаёт заявку и подтверждает её СМС-кодом")
Person(ccOperator, "Оператор кол-центра", "Перезванивает новым клиентам, может предложить особые условия")
Person(branch, "Сотрудник отделения", "Идентифицирует нового клиента, открывает депозит")
Person(depBO, "Менеджер бэк-офиса депозитов", "Ведёт ставки, подтверждает условия заявок")
Person(credBO, "Сотрудник бэк-офиса кредитов", "Ведёт параметры кредитного риска для ставок")

System(depositSys, "Система онлайн-открытия депозитов (новая)", "Приём заявок, каталог и кеш ставок, OTP и уведомления, асинхронная интеграция с АБС через Kafka", $tags="new")

System(site, "Сайт", "PHP, React.js. Доработка: каталог депозитов, форма заявки")
System(ib, "Интернет-банк", "ASP.NET MVC, .NET 4.5, MS SQL. Доработка: раздел «Депозиты»")
System(cc, "Система кол-центра", "CRM-платформа подрядчика: Java, React, PostgreSQL. Доработка: приём заявок с сайта")
System(abs, "АБС", "Delphi, Oracle PL/SQL. Доработка: справочник ставок, обработка заявок, публикация событий")
System(sms, "СМС-шлюз", "Шлюз отправки СМС, поддерживается IT банка")
System_Ext(telecom, "Телеком-оператор", "Доставка СМС клиентам")

Rel(newClient, site, "Смотрит ставки, подаёт заявку", "HTTPS")
Rel(client, ib, "Смотрит ставки, подаёт заявку, вводит СМС-код", "HTTPS")
Rel(site, depositSys, "Ставки, заявки новых клиентов", "REST/HTTPS")
Rel(ib, depositSys, "Ставки, заявки, OTP, статусы", "REST/HTTPS")
Rel(depositSys, cc, "Заявки новых клиентов", "Kafka")
Rel(cc, depositSys, "Результат звонка, запрос особых условий", "Kafka")
Rel(depositSys, abs, "Заявки на обработку (с ограничением скорости)", "Kafka → адаптер → PL/SQL")
Rel(abs, depositSys, "Ставки, персональные предложения, статусы заявок", "Outbox → адаптер → Kafka")
Rel(depositSys, sms, "OTP и уведомления", "HTTPS")
Rel(sms, telecom, "Отправка СМС")
Rel(telecom, client, "СМС")
Rel(telecom, newClient, "СМС")

Rel(ccOperator, cc, "Обрабатывает заявки, звонит клиенту")
Rel(branch, abs, "Находит заявку, идентифицирует клиента, открывает депозит")
Rel(depBO, abs, "Ведёт ставки, подтверждает условия заявок")
Rel(credBO, abs, "Ведёт параметры риска (отдельная роль)")

SHOW_LEGEND()
@enduml
